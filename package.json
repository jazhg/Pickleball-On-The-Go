{
  "name": "pickleball-on-the-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "dev:http": "node --env-file-if-exists=.env server/index.js --http",
    "certs": "node scripts/setup-https.js",
    "test": "node --test tests/*.test.js",
    "test:py": "python3 -m unittest discover -s nemotron/tests",
    "test:all": "npm test && npm run test:py"
  },
  "dependencies": { "ws": "8.18.3" }
}
